#!/usr/bin/env bash
# aether-theme — switch AetherOS between light and dark mode
set -euo pipefail

BG_DIR=/usr/share/backgrounds/aetheros

usage() { echo "Usage: aether-theme [light|dark|status]"; }

set_dark() {
    xfconf-query -c xsettings -p /Net/ThemeName -s "Arc-Dark" 2>/dev/null || true
    xfconf-query -c xfwm4 -p /general/theme -s "Arc-Dark" 2>/dev/null || true
    xfconf-query -c xsettings -p /Net/IconThemeName -s "Papirus-Dark" 2>/dev/null || true
    xfconf-query -c xfce4-desktop -p /backdrop/screen0/monitor0/workspace0/last-image \
        -s "${BG_DIR}/aetheros-default.png" 2>/dev/null || true
    echo "AetherOS: switched to Aether Dark."
}

set_light() {
    xfconf-query -c xsettings -p /Net/ThemeName -s "Arc" 2>/dev/null || true
    xfconf-query -c xfwm4 -p /general/theme -s "Arc" 2>/dev/null || true
    xfconf-query -c xsettings -p /Net/IconThemeName -s "Papirus-Light" 2>/dev/null || true
    xfconf-query -c xfce4-desktop -p /backdrop/screen0/monitor0/workspace0/last-image \
        -s "${BG_DIR}/aetheros-light.png" 2>/dev/null || true
    echo "AetherOS: switched to Aether Light."
}

case "${1:-}" in
    dark)  set_dark ;;
    light) set_light ;;
    status)
        xfconf-query -c xsettings -p /Net/ThemeName 2>/dev/null || echo "unknown"
        ;;
    *) usage; exit 1 ;;
esac
