// AetherOS Plymouth boot splash
// Echoes the desktop wallpaper's glowing "light streak" motif: a thin
// teal progress bar that fills left-to-right as the system boots,
// instead of a generic spinner.

Window.SetBackgroundTopColor(0.03, 0.04, 0.07);
Window.SetBackgroundBottomColor(0.05, 0.08, 0.15);

// --- logo (the user's own mascot, gently pulsing) ---
logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetWidth()  / 2 - logo.image.GetWidth()  / 2);
logo.sprite.SetY(Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - 60);

// --- "Starting AetherOS..." caption ---
message.image = Image.Text("Starting AetherOS...", 0.85, 0.92, 0.95, 1);
message.sprite = Sprite(message.image);
message.sprite.SetX(Window.GetWidth()  / 2 - message.image.GetWidth() / 2);
message.sprite.SetY(Window.GetHeight() / 2 + logo.image.GetHeight() / 2 + 34);

// --- streak-style progress bar ---
bar_max_width = Window.GetWidth() * 0.34;
bar_height = 3;
bar_x = Window.GetWidth() / 2 - bar_max_width / 2;
bar_y = message.sprite.GetY() + 34;

track.image = Image("bar_track.png").Scale(bar_max_width, bar_height);
track.sprite = Sprite(track.image);
track.sprite.SetX(bar_x);
track.sprite.SetY(bar_y);

fill.base_image = Image("bar_fill.png");
fill.sprite = Sprite();
fill.sprite.SetX(bar_x);
fill.sprite.SetY(bar_y);

// --- animation: gentle pulse on the logo ---
fun refresh_callback() {
    t = Plymouth.GetTime();
    opacity = 0.75 + 0.25 * Math.Sin(t * 3);
    logo.sprite.SetOpacity(opacity);
}
Plymouth.SetRefreshFunction(refresh_callback);

// --- animation: bar fills with real boot progress ---
fun progress_callback(duration, progress) {
    w = bar_max_width * progress;
    if (w < 2) {
        w = 2;
    }
    fill.sprite.SetImage(fill.base_image.Scale(w, bar_height));
}
Plymouth.SetBootProgressFunction(progress_callback);
